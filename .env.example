# Placeholder names only. No production keys, URLs or real identity data in source.
# Copy to .env.local for development; every variable is documented in docs/DEPLOYMENT_RENDER.md.
NODE_ENV=development
PUBLIC_APP_NAME=HEARD

# --- Core -------------------------------------------------------------------
HEARD_ENV=local
# HEARD_PUBLIC_ORIGIN=http://localhost:3000
# HEARD_BUILD_SHA=
HEARD_LOG_LEVEL=info

# --- Database (Neon PostgreSQL in staging/production) ------------------------
# DATABASE_URL=
# HEARD_DATABASE_POOL_MAX=5
# HEARD_MIGRATE_ON_START=false
# HEARD_OPERATIONS_TOKEN=

# --- Private intake (disabled by default) ------------------------------------
HEARD_INTAKE_ENABLED=false
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# HEARD_SESSION_SECRET=
# HEARD_DATA_ENCRYPTION_KEY=
# HEARD_DATA_ENCRYPTION_KEY_ID=k1

# --- Secure Intake & Case Workflow Engine adapter ----------------------------
HEARD_SECURE_INTAKE_MODE=local
# HEARD_SECURE_INTAKE_URL=
# HEARD_SECURE_INTAKE_API_VERSION=
# HEARD_SECURE_INTAKE_TOKEN=

# --- Private object storage (Backblaze B2, S3-compatible) --------------------
HEARD_OBJECT_STORAGE_DRIVER=none
# HEARD_OBJECT_STORAGE_DIR=
# HEARD_S3_ENDPOINT=
# HEARD_S3_REGION=
# HEARD_S3_BUCKET=
# HEARD_S3_ACCESS_KEY_ID=
# HEARD_S3_SECRET_ACCESS_KEY=

# --- Malware scanning --------------------------------------------------------
HEARD_SCANNER_DRIVER=none
# HEARD_CLAMD_HOST=
# HEARD_CLAMD_PORT=3310
